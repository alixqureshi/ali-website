# Configure in the deployment's secret manager. Never commit real keys.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_PRICE_ID=
WORKSHOP_COHORT_ID=
CHECKOUT_ENABLED=false
SITE_ORIGIN=https://aliqureshi.co
WORKSHOP_START_AT=
# Set 1 only on Railway's single trusted reverse proxy; use 0 locally.
TRUST_PROXY_HOPS=0
ALLOWED_ORIGINS=https://aliqureshi.co,https://www.aliqureshi.co
DATABASE_PATH=/data/bookings.sqlite
PORT=3000
